{
  "name": "stock-investing",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "news-google": "tsx --env-file=.env scripts/news-google.ts",
    "news-finnhub": "tsx --env-file=.env scripts/news-finnhub.ts",
    "pse-edge": "tsx --env-file=.env scripts/pse-edge.ts",
    "scrape-ms": "tsx --env-file=.env scripts/scrape-morningstar.ts",
    "scrape-psei30": "tsx --env-file=.env scripts/scrape-psei30.ts",
    "backup-db": "mkdir -p data && docker exec stocks-db pg_dump -U postgres stocks > data/backup-$(date +%Y%m%d-%H%M).sql && echo Done",
    "refresh-cookies": "tsx --env-file=.env scripts/refresh-cookies.ts",
    "login-morningstar": "tsx --env-file=.env scripts/login-morningstar.ts",
    "scrape-all-pse": "tsx --env-file=.env scripts/scrape-all-pse.ts",
    "refresh-missing-2025": "tsx --env-file=.env scripts/refresh-missing-2025.ts"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.20.0",
    "playwright": "^1.58.2",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
