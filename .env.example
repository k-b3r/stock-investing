# === PostgreSQL ===
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=psei_research

# === API ===
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stocks"
API_PORT=3001
NODE_ENV=development

# === Morningstar (browser session tokens, expire ~1hr — grab from DevTools Network tab) ===
MS_TOKEN=           # Authorization: Bearer <JWT>
MS_REALTIME_E=      # x-api-realtime-e header value
MS_SAL_CONTENT=     # x-sal-contenttype header value
# MS_COOKIE and MS_WAF_TOKEN no longer needed — Bearer token handles both lookup and data

# === Anthropic ===
ANTHROPIC_API_KEY=your_key_here
CLAUDE_MODEL=claude-sonnet-4-6

# === Scraper ===
PSE_EDGE_BASE_URL=https://edge.pse.com.ph
SCRAPER_REQUEST_DELAY_MS=500
SCRAPER_PROXY_URL=
# Cron schedule: default = weekdays at 6pm PHT (10:00 UTC)
SCRAPER_CRON_SCHEDULE="0 10 * * 1-5"

# === App (Next.js) ===
NEXT_PUBLIC_API_URL=http://localhost:3001
